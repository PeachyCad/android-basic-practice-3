<resources>
    <!-- Скругление картинки товара 16dp, как в макете -->
    <style name="ShapeAppearance.ViewResources.CartImage" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">16dp</item>
    </style>

    <!-- Строки итогов корзины: подпись слева, сумма справа -->
    <style name="Widget.ViewResources.CartSummaryLabel" parent="">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:textAppearance">?attr/textAppearanceTitleMedium</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
    </style>

    <style name="Widget.ViewResources.CartSummaryValue" parent="">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textAppearance">?attr/textAppearanceTitleMedium</item>
        <item name="android:textColor">?attr/colorTertiary</item>
    </style>

    <style name="Widget.ViewResources.CartSummaryRow" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:paddingHorizontal">@dimen/list_padding</item>
        <item name="android:paddingVertical">4dp</item>
    </style>
</resources>
